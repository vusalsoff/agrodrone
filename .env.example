# ==============================================================================
# AgroDrone — Root Environment Configuration Template
# Copy this file to .env and adjust values for your local or deployed environment.
# NEVER commit real secrets to version control.
# ==============================================================================

# --- Environment Profile ---
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- PostgreSQL (Primary Production & Docker Compose Database) ---
POSTGRES_USER=agrodrone
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=agrodrone
POSTGRES_PORT=5432

# Backend Database URL:
# - Docker / PostgreSQL: postgresql+psycopg://agrodrone:change-me-in-production@localhost:5432/agrodrone
# - Zero-Docker Local Dev Fallback (SQLite): sqlite:///./data/agrodrone_dev.db
DATABASE_URL=postgresql+psycopg://agrodrone:change-me-in-production@localhost:5432/agrodrone

# --- FastAPI Backend ---
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Authentication, Cookies & Rate Limiting ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-cryptographically-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- S3-Compatible Object Storage (MinIO in dev, AWS S3 / R2 / GCS in prod) ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=agrodrone-minio
S3_SECRET_ACCESS_KEY=change-me-minio-secret
S3_BUCKET_MEDIA=agrodrone-media
S3_REGION=us-east-1
S3_PRESIGN_EXPIRE_SECONDS=300
MAX_IMAGE_UPLOAD_BYTES=20971520
MAX_VIDEO_UPLOAD_BYTES=157286400
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- AI Inference (Phase 3: Server-Side Image Upload + YOLO) ---
AI_INFERENCE_ENABLED=true
AI_MODEL_PROFILE=yolov8n-coco-general
AI_MODEL_WEIGHTS_PATH=
AI_DEVICE=cpu
AI_CONFIDENCE_THRESHOLD=0.35
# inline_thread (local dev, API thread pool) | external (separate: python -m app.worker)
AI_WORKER_MODE=inline_thread
AI_WEIGHTS_DIR=
AI_MAX_JOB_ATTEMPTS=3
MAX_VIDEO_DURATION_SECONDS=120
MAX_VIDEO_SAMPLED_FRAMES=60
DEFAULT_FRAME_SAMPLE_INTERVAL_MS=1000

# --- ESP32-CAM Hardware & Edge Gateway Policy ---
# IMPORTANT: The ESP32-CAM currently runs as an isolated Wi-Fi AP (SSID: agroDrone, 192.168.4.1).
# Public cloud servers CANNOT directly reach 192.168.4.1. Keep direct probing disabled in cloud deployments.
ESP32_DEFAULT_AP_SSID=agroDrone
ESP32_DEFAULT_BASE_URL=http://192.168.4.1
ESP32_DEFAULT_STREAM_URL=http://192.168.4.1:81/stream
ALLOW_DIRECT_LOCAL_CAMERA_PROBE=false
EDGE_GATEWAY_ENABLED=true
GATEWAY_HEARTBEAT_TTL_SECONDS=30

# --- Next.js Frontend ---
NEXT_PUBLIC_APP_NAME=AgroDrone
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_ENVIRONMENT=development
NEXT_PUBLIC_MAP_STYLE_URL=

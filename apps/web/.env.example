# ==============================================================================
# AgroDrone Web — Environment Template
# Copy to apps/web/.env.local for local execution.
# ==============================================================================

NEXT_PUBLIC_APP_NAME=AgroDrone
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_ENVIRONMENT=development

# Optional custom MapLibre vector style URL (leave blank to use built-in dark grid style)
NEXT_PUBLIC_MAP_STYLE_URL=

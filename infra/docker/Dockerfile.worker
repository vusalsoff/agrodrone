# syntax=docker/dockerfile:1
FROM python:3.12-slim AS builder

ARG INSTALL_AI_EXTRAS=true

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_SYSTEM_PYTHON=1

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libgl1 \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir uv==0.6.14

COPY services/ai-worker ./services/ai-worker
COPY services/edge-gateway ./services/edge-gateway
COPY apps/api/pyproject.toml ./apps/api/pyproject.toml
COPY apps/api/app ./apps/api/app

RUN if [ "$INSTALL_AI_EXTRAS" = "true" ]; then \
      uv pip install --no-cache --system "./apps/api[s3,ai]" ./services/ai-worker ./services/edge-gateway; \
    else \
      uv pip install --no-cache --system "./apps/api[s3]" ./services/ai-worker ./services/edge-gateway; \
    fi

FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app/apps/api

RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
COPY services ./services
COPY apps/api/app ./app

RUN adduser --disabled-password --gecos "" appuser \
    && mkdir -p /app/apps/api/data/storage /app/models \
    && chown -R appuser:appuser /app

USER appuser
STOPSIGNAL SIGTERM

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -m app.worker --healthcheck

CMD ["python", "-m", "app.worker"]

{
  "Rules": [
    {
      "ID": "AbortIncompleteMultipartUploads",
      "Status": "Enabled",
      "Filter": { "Prefix": "" },
      "AbortIncompleteMultipartUpload": { "DaysAfterInitiation": 2 }
    },
    {
      "ID": "TransitionOldMediaToInfrequentAccess",
      "Status": "Enabled",
      "Filter": { "Prefix": "media/" },
      "Transitions": [
        { "Days": 90, "StorageClass": "STANDARD_IA" }
      ]
    },
    {
      "ID": "ExpireTransientAnnotatedPreviews",
      "Status": "Enabled",
      "Filter": { "Prefix": "annotated/tmp/" },
      "Expiration": { "Days": 30 }
    }
  ]
}
